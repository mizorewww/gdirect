-  if (uri::parse(us, currentUri_)) {
-    us_.swap(us);
-    return true;
+  if (uri::parse(us, currentUri_) && us.protocol == "https") {
+    if (gdirect_sni && *gdirect_sni && gdirect_host(us.host)) {
+      // Forged identity: the connection, SNI and certificate name become
+      // gdirect_sni; the real host is kept only for the HTTP Host header.
+      gdirectHostHeader_ = us.host;
+      us.host = gdirect_sni;
+      us_.swap(us);
+      return true;
+    }
+    // Real hosts pass through unchanged.
+    if (gdirect_host(us.host)) {
+      gdirectHostHeader_.clear();
+      us_.swap(us);
+      return true;
+    }
+    // A redirect relative to an already swapped URI lands on the forged host
+    // and keeps this request's Host header.
+    if (gdirect_sni && *gdirect_sni && us.host == gdirect_sni) {
+      us_.swap(us);
+      return true;
+    }
   }
-  else {
-    return false;
-  }
+  return false;
 }
 
